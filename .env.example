# Neon pooled connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require"

# Neon direct connection used only by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"

# GitHub OAuth App credentials.
AUTH_GITHUB_ID="replace-with-github-client-id"
AUTH_GITHUB_SECRET="replace-with-github-client-secret"
